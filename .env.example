# Firebase web app config — from Firebase Console > Project settings > Your apps
# None of these are secret; they're safe to ship in the client bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Region your Cloud Functions are deployed to (must match functions/index.js)
VITE_FUNCTIONS_REGION=asia-south1
