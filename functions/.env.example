# GCP project running the Document AI processor (usually same as your Firebase project)
GCP_PROJECT_ID=
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=

# ANTHROPIC_API_KEY is intentionally NOT set here — store it as a Cloud Functions
# secret instead, so it never sits in a plaintext .env on disk or in source control:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
