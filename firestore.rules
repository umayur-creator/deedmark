rules_version = '2';

// Data model:
//   organizations/{orgId}                  { name, createdAt, createdBy }
//   organizations/{orgId}/members/{uid}    { role: 'admin' | 'partner' | 'associate', email, joinedAt }
//   userOrgMembership/{uid}                { orgId, role, email }
//   matters/{matterId}                     { orgId, partnerId, associateIds: [...], clientIds: [...], ... }
//   matters/{matterId}/documents/{docId}
//   matters/{matterId}/analysis/{analysisId}
//   matters/{matterId}/documents/{docId}/highlights/{highlightId}
//   matters/{matterId}/documents/{docId}/highlights/{highlightId}/comments/{commentId}

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function orgMembership() {
      return get(/databases/$(database)/documents/userOrgMembership/$(request.auth.uid)).data;
    }

    function isOrgMember(orgId) {
      return isSignedIn() && orgMembership().orgId == orgId;
    }

    function orgRole(orgId) {
      return isOrgMember(orgId) ? orgMembership().role : null;
    }

    function isOrgAdmin(orgId) {
      return orgRole(orgId) == 'admin';
    }

    function isOnMatterTeam(matterData) {
      return isSignedIn() && (
        request.auth.uid == matterData.partnerId ||
        request.auth.uid in matterData.associateIds
      );
    }

    function canSeeMatter(matterData) {
      return isOrgAdmin(matterData.orgId) ||
             (matterData.status == 'unclaimed' && isOrgMember(matterData.orgId)) ||
             isOnMatterTeam(matterData);
    }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /userOrgMembership/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId);
      allow write: if false;

      match /members/{memberUid} {
        allow read: if isOrgMember(orgId);
        allow write: if false;
      }

      match /invites/{inviteId} {
        allow read, write: if isOrgAdmin(orgId);
      }

      match /clients/{clientId} {
        allow read: if isOrgMember(orgId);
        allow write: if false;
      }
    }

    match /matters/{matterId} {
      allow read: if isSignedIn() &&
        get(/databases/$(database)/documents/userOrgMembership/$(request.auth.uid)).data.orgId == resource.data.orgId;
      allow create: if false;
      allow update: if isOrgAdmin(request.resource.data.orgId) ||
                       (isOnMatterTeam(resource.data) && orgRole(resource.data.orgId) == 'partner');
      allow delete: if false;

      match /documents/{docId} {
        allow read: if canSeeMatter(get(/databases/$(database)/documents/matters/$(matterId)).data);
        allow create: if canSeeMatter(get(/databases/$(database)/documents/matters/$(matterId)).data);
        allow update, delete: if isOrgAdmin(get(/databases/$(database)/documents/matters/$(matterId)).data.orgId);

        match /highlights/{highlightId} {
          allow read, create: if canSeeMatter(get(/databases/$(database)/documents/matters/$(matterId)).data);
          allow update, delete: if isOrgAdmin(get(/databases/$(database)/documents/matters/$(matterId)).data.orgId);

          match /comments/{commentId} {
            allow read, create: if canSeeMatter(get(/databases/$(database)/documents/matters/$(matterId)).data);
            allow update, delete: if isOrgAdmin(get(/databases/$(database)/documents/matters/$(matterId)).data.orgId);
          }
        }
      }

      match /analysis/{analysisId} {
        allow read: if canSeeMatter(get(/databases/$(database)/documents/matters/$(matterId)).data);
        allow write: if false;
      }
    }
  }
}